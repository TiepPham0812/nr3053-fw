#!/bin/sh
# Cau hinh mac dinh cho SDMC NR3053 co mod USB
# Ten "zz-" de chay SAU moi script mac dinh khac (khong bi ghi de).

# Mui gio + NTP Viet Nam
uci set system.@system[0].zonename='Asia/Ho Chi Minh'
uci set system.@system[0].timezone='<+07>-7'
uci -q delete system.ntp.server
uci add_list system.ntp.server='vn.pool.ntp.org'
uci add_list system.ntp.server='time.cloudflare.com'
uci add_list system.ntp.server='time.google.com'
uci commit system

# Kho goi: luon dung may chu chinh hang ImmortalWrt
sed -i -E 's,https?://[^ ]*/(releases|snapshots)/,https://downloads.immortalwrt.org/\1/,' \
	/etc/apk/repositories.d/distfeeds.list 2>/dev/null

# Wi-Fi: ma quoc gia Viet Nam (mac dinh ImmortalWrt la CN)
[ -s /etc/config/wireless ] || /sbin/wifi config >/dev/null 2>&1
for r in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	uci set wireless.$r.country='VN'
done
uci commit wireless

# Bo cong lan4 khong ton tai khoi br-lan (neu cau hinh cu con sot)
for d in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)\.name='br-lan'$/\1/p"); do
	uci -q del_list network.$d.ports='lan4'
done

# Chia tai mang cho ca 2 nhan CPU (khong dung phan cung)
uci set network.globals.packet_steering='1'

# WAN qua dien thoai Android (USB tethering -> usb0)
if ! uci -q get network.android >/dev/null; then
	uci set network.android=interface
	uci set network.android.proto='dhcp'
	uci set network.android.device='usb0'
	uci set network.android.metric='10'
	uci add_list firewall.@zone[1].network='android'
fi

# WAN qua iPhone (ipheth -> thuong la eth1)
if ! uci -q get network.iphone >/dev/null; then
	uci set network.iphone=interface
	uci set network.iphone.proto='dhcp'
	uci set network.iphone.device='eth1'
	uci set network.iphone.metric='11'
	uci add_list firewall.@zone[1].network='iphone'
fi

uci commit network
uci commit firewall

# Tu khoi dong usbmuxd + giu ghep doi iPhone qua cac lan khoi dong
[ -x /etc/init.d/usbmuxd ] && /etc/init.d/usbmuxd enable
[ -x /etc/init.d/lockdown-persist ] && /etc/init.d/lockdown-persist enable
# Giu ghep doi iPhone ca khi nang cap firmware co "Keep settings"
grep -qx "/etc/lockdown/" /etc/sysupgrade.conf 2>/dev/null || echo "/etc/lockdown/" >> /etc/sysupgrade.conf

exit 0
